$ annotary -p agent thread new hist-rfc "313:6-313:49" -m "On which fleet?"
t5	v1:313:6-313:49 "takes around nine days on the current fleet"

$ annotary -p rowan push hist/2/hist-rfc.md --doc hist-rfc -m "v2"
