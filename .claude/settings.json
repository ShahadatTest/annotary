{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help:*)",
      "Bash(make build:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make ci:*)",
      "Bash(make standard-lint:*)",
      "Bash(make deploy:*)",
      "Bash(make server-health:*)"
    ],
    "ask": [
      "Edit(**/migrations/**)",
      "Write(**/migrations/**)",
      "Edit(**/alembic/versions/**)",
      "Write(**/alembic/versions/**)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/trim-target.sh --quiet",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/trim-target.sh --quiet",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
